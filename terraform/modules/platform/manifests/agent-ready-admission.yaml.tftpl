# ---------------------------------------------------------------------------
# Périmètre du pipeline « Agent Ready » de l'équipe IA (CEL, Kubernetes ≥ 1.30).
# RBAC accorde des verbes sur des types ; cette politique borne OÙ. Le
# périmètre, ce sont les objets marqués agentic.io/agent-ready=true — posé
# par Agent Ready lui-même, vérifié AVANT et APRÈS chaque modification :
#   - namespaces : agentic.io/agent-ready=true et agentic.io/team = leur nom,
#     sur l'objet créé ET sur l'objet existant (pas de « réétiquetage » de
#     kagent ou de agentgateway-system pour l'attirer dans le périmètre) ;
#     Pod Security « baseline » au moins, qu'on ne peut pas retirer (pas de pod
#     privilégié, de hostPath ni de réseau de l'hôte : pas de prise de nœud) ;
#     jamais un nom de la plateforme (pas de namespace pré-créé pour la piéger) ;
#   - RoleBindings : vers agentic-team-deployer seulement, pour UN utilisateur
#     (l'identité du pipeline de l'équipe), jamais le pipeline lui-même, un
#     groupe ou un compte system: ;
#   - quotas, limites, NetworkPolicies, RoleBindings, Secrets : dans un
#     namespace Agent Ready ;
#   - Secrets dans agentgateway-system : vk-*, labels agentic.io/virtual-key
#     et agentic.io/agent-ready (les clés de la plateforme restent hors d'atteinte).
# ---------------------------------------------------------------------------
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: agent-ready-perimetre
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE", "DELETE"]
        resources: ["namespaces", "secrets", "resourcequotas", "limitranges"]
      - apiGroups: ["rbac.authorization.k8s.io"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE", "DELETE"]
        resources: ["rolebindings"]
      - apiGroups: ["networking.k8s.io"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE", "DELETE"]
        resources: ["networkpolicies"]
  matchConditions:
    - name: pipeline-agent-ready
      expression: request.userInfo.username == '${principal_id}'
  variables:
    # Objets à vérifier : le nouveau (CREATE, UPDATE) et l'existant (UPDATE, DELETE).
    - name: objets
      expression: >-
        request.operation == 'CREATE' ? [object] :
        (request.operation == 'DELETE' ? [oldObject] : [object, oldObject])
    - name: equipe
      expression: >-
        request.resource.resource != 'namespaces' &&
        has(namespaceObject.metadata.labels) &&
        'agentic.io/agent-ready' in namespaceObject.metadata.labels &&
        namespaceObject.metadata.labels['agentic.io/agent-ready'] == 'true'
  validations:
    - expression: >-
        request.resource.resource != 'namespaces' ||
        variables.objets.all(o, has(o.metadata.labels) &&
          'agentic.io/agent-ready' in o.metadata.labels && o.metadata.labels['agentic.io/agent-ready'] == 'true' &&
          'agentic.io/team' in o.metadata.labels && o.metadata.labels['agentic.io/team'] == o.metadata.name)
      message: "namespace hors périmètre Agent Ready"
    - expression: >-
        request.resource.resource != 'namespaces' || request.operation == 'DELETE' ||
        (has(object.metadata.labels) &&
         'pod-security.kubernetes.io/enforce' in object.metadata.labels &&
         object.metadata.labels['pod-security.kubernetes.io/enforce'] in ['baseline', 'restricted'])
      message: "namespace d'équipe : pod-security.kubernetes.io/enforce=baseline (ou restricted) obligatoire"
    - expression: >-
        request.resource.resource != 'namespaces' ||
        variables.objets.all(o, !(o.metadata.name in ${noms_reserves}) &&
          !o.metadata.name.startsWith('kube-') && !o.metadata.name.startsWith('agentgateway'))
      message: "nom de namespace réservé à la plateforme"
    - expression: >-
        request.resource.resource != 'rolebindings' ||
        variables.objets.all(o, o.roleRef.kind == 'ClusterRole' && o.roleRef.name == 'agentic-team-deployer' &&
          has(o.subjects) && size(o.subjects) == 1 &&
          o.subjects.all(s, s.kind == 'User' && s.name != '${principal_id}' && !s.name.startsWith('system:')))
      message: "RoleBinding : agentic-team-deployer pour l'identité du pipeline de l'équipe, rien d'autre"
    - expression: >-
        request.resource.resource != 'secrets' || variables.equipe ||
        (request.namespace == 'agentgateway-system' &&
         variables.objets.all(o, o.metadata.name.startsWith('vk-') && has(o.metadata.labels) &&
           'agentic.io/virtual-key' in o.metadata.labels && o.metadata.labels['agentic.io/virtual-key'] == 'true' &&
           'agentic.io/agent-ready' in o.metadata.labels && o.metadata.labels['agentic.io/agent-ready'] == 'true'))
      message: "Secret hors périmètre : namespace Agent Ready, ou clé virtuelle vk-<équipe> créée par Agent Ready"
    - expression: >-
        request.resource.resource in ['namespaces', 'secrets'] || variables.equipe
      message: "quota, limites, NetworkPolicy et RoleBinding : uniquement dans un namespace Agent Ready"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: agent-ready-perimetre
spec:
  policyName: agent-ready-perimetre
  validationActions: [Deny]
