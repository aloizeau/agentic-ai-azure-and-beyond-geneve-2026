# -----------------------------------------------------------------------------
# Who may reach the platform's own components inside the cluster.
#
# Without these, any pod — a team's agent, an MCP server steered by a prompt —
# could call them directly, around the gateway and its Entra ID check:
#   - Grafana trusts the X-Forwarded-Email header of oauth2-proxy (public.tf):
#     reachable by anyone, that header would sign in as any user;
#   - the kagent controller serves invoke_agent (MCP) and the UI's API;
#   - agentregistry (open-source edition) has no authentication at all.
# kubectl port-forward is not filtered (it enters the pod itself): the
# presenter's access is unchanged.
# VÉRIFIER (D-7): kagent and agentregistry declare no admission webhook in the
# pinned charts (`kubectl get validatingwebhookconfigurations,mutatingwebhookconfigurations`)
# — a webhook served from these namespaces would need an ingress rule for the
# API server.
# -----------------------------------------------------------------------------

resource "kubernetes_network_policy" "grafana" {
  metadata {
    name      = "grafana-entrees"
    namespace = kubernetes_namespace.this["monitoring"].metadata[0].name
  }
  spec {
    pod_selector {
      match_labels = { "app.kubernetes.io/name" = "grafana" }
    }
    policy_types = ["Ingress"]
    ingress {
      # oauth2-proxy-grafana, Prometheus (metrics), the dashboard sidecar: the
      # monitoring namespace holds platform components only.
      from {
        pod_selector {}
      }
      # The optional Grafana MCP server (tools/enterprise, API key).
      from {
        namespace_selector {
          match_labels = { "kubernetes.io/metadata.name" = "outils-entreprise" }
        }
        pod_selector {
          match_labels = { app = "mcp-grafana" }
        }
      }
    }
  }
}

# Every kagent pod (controller, UI and its oauth2-proxy, the platform's
# agents): the namespace itself, the gateway's proxies, Prometheus. Team
# namespaces are NOT here: see kagent-controleur-equipes.
resource "kubernetes_network_policy" "kagent" {
  metadata {
    name      = "kagent-entrees"
    namespace = kubernetes_namespace.this["kagent"].metadata[0].name
  }
  spec {
    pod_selector {}
    policy_types = ["Ingress"]
    ingress {
      # The controller, the UI and its oauth2-proxy, the platform's agents.
      from {
        pod_selector {}
      }
      # The gateway's proxies only (/mcp → invoke_agent with the user's Entra ID
      # token; the public listener → kagent UI behind oauth2-proxy) — not the
      # other pods of agentgateway-system (controller, adapters).
      # VÉRIFIER (D-7): label of the proxy pods generated by agentgateway v1.5.0
      # (kubectl get pods -n agentgateway-system --show-labels).
      from {
        namespace_selector {
          match_labels = { "kubernetes.io/metadata.name" = "agentgateway-system" }
        }
        pod_selector {
          match_expressions {
            key      = "gateway.networking.k8s.io/gateway-name"
            operator = "Exists"
          }
        }
      }
      # Prometheus (scrapes; the metrics ports differ between components).
      from {
        namespace_selector {
          match_labels = { "kubernetes.io/metadata.name" = "monitoring" }
        }
      }
    }
  }
}

# Team agents call back the kagent controller (sessions, tasks) on :8083 —
# the controller only, that port only, from agent pods only. Before, a team
# namespace reached every pod and port of kagent: the controller's /mcp
# (invoke_agent on any agent, no authentication), the platform's agents, the UI.
# Labels are self-declared: a team pod labelled like an agent gets the same
# access — defense in depth, the controller remains reachable on :8083.
# VÉRIFIER (D-7), kagent chart 0.10.1:
#   - controller pod labels (kagent.controller.selectorLabels):
#     kubectl get pods -n kagent -l app.kubernetes.io/component=controller --show-labels
#   - agent pod labels (app=kagent, kagent=<agent>):
#     kubectl get pods -n <équipe> --show-labels
resource "kubernetes_network_policy" "kagent_controller_teams" {
  metadata {
    name      = "kagent-controleur-equipes"
    namespace = kubernetes_namespace.this["kagent"].metadata[0].name
  }
  spec {
    pod_selector {
      match_labels = {
        "app.kubernetes.io/name"      = "kagent"
        "app.kubernetes.io/component" = "controller"
      }
    }
    policy_types = ["Ingress"]
    ingress {
      from {
        namespace_selector {
          match_expressions {
            key      = "agentic.io/team"
            operator = "Exists"
          }
        }
        pod_selector {
          match_labels = { app = "kagent" }
          match_expressions {
            key      = "kagent"
            operator = "Exists"
          }
        }
      }
      ports {
        port     = "8083"
        protocol = "TCP"
      }
    }
  }
}

# Defense in depth, cluster-wide: no pod of a team namespace (label
# agentic.io/team — Agent Ready teams and var.teams alike) reaches IMDS
# (169.254.169.254: token of the kubelet identity, far wider than the team's)
# or the Azure wireserver (168.63.129.16), whatever NetworkPolicy the
# namespace holds. A deny rule wins over every allow rule; enableDefaultDeny
# false: this policy alone does not close the rest of the egress.
# Azure CNI powered by Cilium supports CiliumClusterwideNetworkPolicy
# (Microsoft Learn, « Configure Azure CNI Powered by Cilium », FAQ).
# VÉRIFIER (D-7): `kubectl get ccnp equipes-sans-imds`, then from a team pod
# `curl -m 3 -H Metadata:true http://169.254.169.254/metadata/instance?api-version=2021-02-01`
# must time out; enableDefaultDeny needs Cilium ≥ 1.15 (kubectl -n kube-system
# get ds cilium -o jsonpath='{..image}').
resource "kubernetes_manifest" "teams_no_imds" {
  manifest = {
    apiVersion = "cilium.io/v2"
    kind       = "CiliumClusterwideNetworkPolicy"
    metadata   = { name = "equipes-sans-imds" }
    spec = {
      description = "Namespaces d'équipe : jamais l'IMDS ni le wireserver Azure"
      endpointSelector = {
        matchExpressions = [
          { key = "io.cilium.k8s.namespace.labels.agentic.io/team", operator = "Exists" },
        ]
      }
      enableDefaultDeny = { egress = false, ingress = false }
      egressDeny = [
        { toCIDR = ["169.254.169.254/32", "168.63.129.16/32"] },
      ]
    }
  }
}

resource "kubernetes_network_policy" "agentregistry" {
  metadata {
    name      = "agentregistry-entrees"
    namespace = kubernetes_namespace.this["agentregistry"].metadata[0].name
  }
  spec {
    pod_selector {}
    policy_types = ["Ingress"]
    ingress {
      # The registry and its database only; people come in with port-forward.
      from {
        pod_selector {}
      }
    }
  }
}
