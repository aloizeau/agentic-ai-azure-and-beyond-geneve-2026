# -----------------------------------------------------------------------------
# Usage dashboard — Grafana, folder "Plateforme IA".
#
# Tokens, cost and MCP tools per user and per team, from the agentgateway
# metrics of both Gateways. The JSON is generated by
# monitoring/src/usage_dashboard.py and loaded by the Grafana dashboard sidecar
# of kube-prometheus-stack (label grafana_dashboard=1, main.tf).
# What feeds it lives in gateway/deploy: metrics.yaml (user, team, agent
# labels), model-costs.json (price list), backend-mcp.yaml (MCP via the gateway).
# -----------------------------------------------------------------------------

resource "kubernetes_config_map" "dashboard_usage" {
  metadata {
    name      = "dashboard-usage-ia"
    namespace = kubernetes_namespace.this["monitoring"].metadata[0].name
    labels    = { grafana_dashboard = "1" }
    annotations = {
      grafana_folder = "Plateforme IA"
    }
  }

  data = {
    "usage-ia.json" = file("${path.root}/../monitoring/dashboards/usage-ia.json")
  }
}

# -----------------------------------------------------------------------------
# Guardrails dashboard — who triggers which rule, on which profile.
# Generated by monitoring/src/guardrails_dashboard.py. Adapter panels fill up
# once enable_nemo_guardrails = true (the adapter's ServiceMonitor lives in
# guardrails/deploy/base/observability.yaml); the gateway panels work without it.
# -----------------------------------------------------------------------------

resource "kubernetes_config_map" "dashboard_guardrails" {
  metadata {
    name      = "dashboard-garde-fous"
    namespace = kubernetes_namespace.this["monitoring"].metadata[0].name
    labels    = { grafana_dashboard = "1" }
    annotations = {
      grafana_folder = "Plateforme IA"
    }
  }

  data = {
    "garde-fous.json" = file("${path.root}/../monitoring/dashboards/garde-fous.json")
  }
}
