
# Guardrails: Foundry content filters run in production today; NeMo Guardrails
# behind the gateway is the R&D target. The webhook is fail-closed: the adapter
# image must exist. scripts/deploy.ps1 builds it in the platform registry
# (default image); set guardrail_adapter_image only to use another registry.
enable_nemo_guardrails = false
# guardrail_adapter_image = "ghcr.io/<owner>/nemo-guardrail-adapter:0.1.0"

# Self-hosted model on AKS (KAITO add-on): off by default, needs GPU quota
# (StandardNVADSA10v5Family, 36 vCPU) and costs ~4.16 $/hour while running.
enable_self_hosted_models     = false
self_hosted_gpu_instance_type = "Standard_NV36ads_A10_v5"

# Enterprise MCP tools (tools/enterprise): off by default. On => Grafana, Azure
# and Microsoft Graph as self-hosted MCP servers behind the gateway (credentials
# via tools/enterprise/run.sh), plus GitHub (per-user OAuth) and Microsoft Learn
# (no auth) as direct LibreChat MCP servers.
enable_enterprise_tools = false

# Usage dashboard (Grafana, folder "Plateforme IA"): tokens, cost and tools per
# user. Per-user labels are fine for a demo; for thousands of users set false.
usage_metrics_per_user = true

# Who may sign in (gateway API, LibreChat, portal): users or groups, object IDs.
# The identity running Terraform is allowed too (assign_current_principal);
# nobody else by default.
# authorized_principal_object_ids = ["<group object ID>"]
# In CI (TF_VAR_assign_current_principal=false): the CI identity is not added,
# and authorized_principal_object_ids must hold the presenter or a group.
# assign_current_principal = true

# The identity running Terraform administers the whole AKS cluster (Kubernetes API
# through Entra ID, kubeconfigs, upgrades and node pools). false in CI
# (TF_VAR_aks_admin_current_principal=false).
# aks_admin_current_principal = true

# « Agent Ready » (démo B): owner/repo of this repository, for the AI team's
# pipeline identity. Its two Azure roles (Contributor on rg-<base>-equipes, RBAC
# Administrator under condition) are assigned by Terraform when run with Owner
# (true, ./scripts/deploy.ps1); in CI set false, then run
# demos/B-agent-equipe/prepare.ps1 once as Owner.
# ai_team_github_repository       = "<owner>/<repo>"
# ai_team_manage_role_assignments = true

# Public exposure (optional): LibreChat, Grafana, kagent UI and the LLM API on
# https://demos.<zone> and https://*.demos.<zone>, Let's Encrypt certificates,
# Entra ID sign-in in front of Grafana and kagent. Needs CLOUDFLARE_API_TOKEN
# (Zone:Read + DNS:Edit on the zone) in the environment of terraform.
# public_exposure = {
#   zone       = "shift-cloud.io"
#   subdomain  = "demos"
#   acme_email = "you@example.com"   # optional, Let's Encrypt contact
#   expose_api = true                # api.demos.<zone>: /v1 and /agents/v1 (default false)
# }
