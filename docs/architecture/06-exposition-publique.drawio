="geometry"/></mxCell><mxCell id="t42" value="Un listener HTTPS par hôte ; le port 80 ne fait que rediriger vers HTTPS et répondre aux défis ACME." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1273" width="626" height="32" as="geometry"/></mxCell><mxCell id="badge4_43" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1310" width="24" height="24" as="geometry"/></mxCell><mxCell id="t44" value="&lt;b&gt;demos&lt;/b&gt; → LibreChat, avec sa propre connexion Entra ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1307" width="626" height="32" as="geometry"/></mxCell><mxCell id="badge5_45" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="1208" width="24" height="24" as="geometry"/></mxCell><mxCell id="t46" value="&lt;b&gt;grafana&lt;/b&gt; et &lt;b&gt;kagent&lt;/b&gt; → oauth2-proxy (Entra ID) avant l'interface, jamais en direct." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="1142" y="1205" width="626" height="32" as="geometry"/></mxCell><mxCell id="badge6_47" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="1