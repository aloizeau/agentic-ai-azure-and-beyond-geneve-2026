yX=0.5;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;jumpStyle=none;" edge="1" parent="1" source="t56" target="t57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t59" value="Appel modèle (Workload Identity, sans clé)" style="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="94" y="1473" width="270" height="18" as="geometry"/></mxCell><mxCell id="t60" value="" style="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1504" width="1" height="1" as="geometry"/></mxCell><mxCell id="t61" value="" style="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="84" y="1504" width="1" height="1" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;jumpStyle=none;dashed=1;dashPattern=4 2;" edge="1" parent="1" source="t60" target="t61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t63" value="Réponse" style="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="94" y="1495" width="270" height="18" as="geometry"/></mxCell><mxCell id="seq_t" value="&lt;b&gt;À retenir&lt;/b&gt;&lt;br&gt;• Le jeton de l'utilisateur sert deux fois : session LibreChat et appel à la passerelle — jamais vers Foundry.&lt;br&gt;• La passerelle ne fait confiance qu'à Entra ID (émetteur, audience) ; elle n'appelle Entra que pour ses clés publiques.&lt;br&gt;• Vers Foundry, une autre identité : celle de la passerelle, fédérée, sans clé ni secret." style="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="440" y="1410" width="1300" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>