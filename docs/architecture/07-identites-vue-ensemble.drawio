tyle="text;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=12;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="440" y="1200" width="200" height="20" as="geometry"/></mxCell><mxCell id="badgeA_36" value="A" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1228" width="24" height="24" as="geometry"/></mxCell><mxCell id="t37" value="LibreChat obtient pour l'utilisateur un jeton dont l'audience est l'API passerelle ; la passerelle le valide à chaque appel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1225" width="1096" height="32" as="geometry"/></mxCell><mxCell id="badgeB_38" value="B" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1262" width="24" height="24" as="geometry"/></mxCell><mxCell id="t39" value="Grafana et kagent UI ne sont publiés que derrière oauth2-proxy : même tenant, application « Portail »." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1259" width="1096" height="32" as="geometry"/></mxCell><mxCell id="badgeC_40" value="C" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1296" width="24" height="24" as="geometry"/></mxCell><mxCell id="t41" value="Un agent n'a jamais de jeton Entra ID : sa clé virtuelle identifie son équipe, pour les plafonds et les coûts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1293" width="1096" height="32" as="geometry"/></mxCell><mxCell id="badgeD_42" value="D" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1330" width="24" height="24" as="geometry"/></mxCell><mxCell id="t43" value="La passerelle seule parle à Foundry, avec sa propre identité : le jeton de l'utilisateur n'est jamais transmis à Foundry." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1327" width="1096" height="32" as="geometry"/></mxCell><mxCell id="badgeE_44" value="E" style="ellipse;html=1;aspect=fixed;fillColor=#243A5E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="1364" width="24" height="24" as="geometry"/></mxCell><mxCell id="t45" value="GitHub Actions n'a aucun secret : Entra ID fait confiance au jeton OIDC de ce dépôt, pour ces trois sujets seulement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1"><mxGeometry x="472" y="1361" width="1096" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>