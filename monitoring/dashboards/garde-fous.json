{
  "uid": "garde-fous",
  "title": "Garde-fous — déclenchements par équipe, règle, profil",
  "description": "Qui déclenche quel garde-fou (NeMo Guardrails + regex native), sur quel profil, et la santé du moteur de règles.",
  "tags": [
    "agentgateway",
    "guardrails",
    "nemo",
    "securite"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "equipe",
        "label": "Équipe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(guardrail_adapter_decisions_total, team)",
        "query": {
          "query": "label_values(guardrail_adapter_decisions_total, team)",
          "refId": "equipe"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "profil",
        "label": "Profil",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(guardrail_adapter_decisions_total, profile)",
        "query": {
          "query": "label_values(guardrail_adapter_decisions_total, profile)",
          "refId": "profil"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "direction",
        "label": "Sens",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(guardrail_adapter_decisions_total, direction)",
        "query": {
          "query": "label_values(guardrail_adapter_decisions_total, direction)",
          "refId": "direction"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "regle",
        "label": "Règle",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(guardrail_adapter_decisions_total, rail)",
        "query": {
          "query": "label_values(guardrail_adapter_decisions_total, rail)",
          "refId": "regle"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Vue d'ensemble — adaptateur NeMo (couche 2), sur la période sélectionnée",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Contrôles",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(guardrail_adapter_decisions_total{team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#0078D4"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Décisions rendues à la passerelle par l'adaptateur (une par requête et par sens : entrée / sortie)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refus",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(guardrail_adapter_decisions_total{action=\"reject\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#D13438"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Requêtes rejetées avant le modèle (HTTP 403), ou 503 si le moteur est en panne (règle « engine-error »)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Masquages",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(guardrail_adapter_decisions_total{action=\"mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF8C00"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Contenu réécrit (entrée) ou réponse remplacée par le texte de refus (sortie : le contrat n'a pas de Reject)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Taux de blocage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(100 * sum(increase(guardrail_adapter_decisions_total{action=~\"reject|mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range])) / sum(increase(guardrail_adapter_decisions_total{team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5C2D91"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Refus + masquages / contrôles. Un taux qui monte pour UNE équipe : regarder sa règle dominante ci-dessous."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erreurs du moteur",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(guardrail_adapter_errors_total{profile=~\"$profil\", direction=~\"$direction\"}[$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#D13438"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Le moteur NeMo a échoué (exception, délai). FAIL_MODE=closed : ces requêtes sont refusées. Doit rester à 0."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Latence p95 du moteur",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(histogram_quantile(0.95, sum by (le) (increase(guardrail_adapter_check_duration_seconds_bucket{direction=~\"$direction\"}[$__range])))) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "#107C10"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Temps passé dans le moteur de règles. Le webhook coupe à 3 s (FailClosed)."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Qui déclenche quoi — où faut-il adapter ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Déclenchements par équipe × règle × profil",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team, rail, profile, direction) (increase(guardrail_adapter_decisions_total{action=\"reject\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team, rail, profile, direction) (increase(guardrail_adapter_decisions_total{action=\"mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0078D4"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Refus"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Masquages"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Refus",
            "desc": true
          }
        ]
      },
      "description": "Une ligne = une règle qui s'est déclenchée pour une équipe. « collaborateurs » = personnes (LibreChat) ; « <équipe> » = agents (clé virtuelle) ; « - » = la passerelle n'a pas transmis l'en-tête x-team.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Refus",
              "Value #B": "Masquages",
              "team": "Équipe",
              "rail": "Règle",
              "profile": "Profil",
              "direction": "Sens"
            },
            "indexByName": {
              "Équipe": 0,
              "Règle": 1,
              "Profil": 2,
              "Sens": 3,
              "Refus": 4,
              "Masquages": 5
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Top règles déclenchées",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (rail) (increase(guardrail_adapter_decisions_total{action=~\"reject|mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{rail}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 28,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Règle de l'adaptateur ou de NeMo qui a refusé / masqué. « engine-error » = panne du moteur, pas une règle de contenu."
    },
    {
      "id": 11,
      "type": "table",
      "title": "Taux de blocage par équipe",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(guardrail_adapter_decisions_total{team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(guardrail_adapter_decisions_total{action=~\"reject|mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (team) (increase(guardrail_adapter_decisions_total{action=~\"reject|mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range])) / sum by (team) (increase(guardrail_adapter_decisions_total{team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0078D4"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Contrôles"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Refus + masquages"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Taux de blocage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Taux de blocage",
            "desc": true
          }
        ]
      },
      "description": "Un taux élevé n'est pas forcément un défaut : c'est un point de départ. Comparer avec la règle dominante (tableau du dessus) avant de toucher aux rails.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Contrôles",
              "Value #B": "Refus + masquages",
              "Value #C": "Taux de blocage",
              "team": "Équipe"
            },
            "indexByName": {
              "Équipe": 0,
              "Contrôles": 1,
              "Refus + masquages": 2,
              "Taux de blocage": 3
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Refus + masquages par modèle",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (model) (increase(guardrail_adapter_decisions_total{action=~\"reject|mask\", team=~\"$equipe\", profile=~\"$profil\", direction=~\"$direction\", rail=~\"$regle\"}[$__range]))",
